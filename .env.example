# Copy to .env, then fill these three values. No scripted/mock LLM in the app.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=
LLM_API_KEY=
# Optional provider-specific fields, e.g. {"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY={}
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
AGENT_CONTEXT_TOKENS=16384
AGENT_MAX_STEPS=8
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_RUN_TOKEN_BUDGET=80000
AGENT_TOOL_TIMEOUT_SECONDS=5
AGENT_DATA_DIR=./data
# Empty = localhost, single-user mode. Otherwise token -> user mapping.
# Use long random tokens, e.g. {"a-long-secret-token":"alice","another-token":"bob"}
AGENT_AUTH_TOKENS={}

